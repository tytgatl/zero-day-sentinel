# Email alerts: use a dedicated mailbox and an app password where supported.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=replace-with-app-password
ALERT_FROM=alerts@example.com
ALERT_TO=you@example.com

# Optional NVD API key; increases rate limits. Never commit real keys.
NVD_API_KEY=

# Optional comma-separated HTTPS RSS/Atom feed URLs from trusted vendors/CERTs.
# Only add feeds you trust and are authorized to access.
ZDS_RSS_FEEDS=

# Optional storage/log settings
# ZDS_DATA_DIR=./data
# LOG_LEVEL=INFO
